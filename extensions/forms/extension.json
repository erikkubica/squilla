{
  "name": "Forms",
  "slug": "forms",
  "version": "2.0.0",
  "author": "Squilla",
  "description": "Production-grade form builder with file uploads, CAPTCHA, conditional logic, webhooks, GDPR compliance, and email notifications.",
  "provides": ["forms"],
  "auto_activate": true,
  "capabilities": [
    "events:subscribe",
    "data:read",
    "data:write",
    "data:delete",
    "email:send",
    "settings:read",
    "log:write",
    "files:write",
    "files:delete",
    "http:fetch",
    "events:emit",
    "users:read"
  ],
  "data_owned_tables": [
    "forms",
    "form_submissions",
    "form_webhook_logs"
  ],
  "blocks": [{ "slug": "vibe-form", "dir": "vibe-form" }],
  "plugins": [
    {
      "binary": "bin/forms",
      "events": []
    }
  ],
  "public_routes": [{ "method": "POST", "path": "/forms/submit/*" }],
  "admin_routes": [
    { "method": "*", "path": "/forms",       "required_capability": "manage_forms" },
    { "method": "*", "path": "/forms/**",    "required_capability": "manage_forms" },
    { "method": "*", "path": "/submissions",     "required_capability": "manage_forms" },
    { "method": "*", "path": "/submissions/**",  "required_capability": "manage_forms" },
    { "method": "POST",   "path": "/**", "required_capability": "manage_forms" },
    { "method": "PUT",    "path": "/**", "required_capability": "manage_forms" },
    { "method": "PATCH",  "path": "/**", "required_capability": "manage_forms" },
    { "method": "DELETE", "path": "/**", "required_capability": "manage_forms" }
  ],
  "mcp_tools": [
    {
      "name": "list",
      "description": "List forms.",
      "class": "full",
      "method": "GET",
      "path": "/",
      "input_schema": {"type": "object", "properties": {}}
    },
    {
      "name": "get",
      "description": "One form with its fields, notifications and settings.",
      "class": "full",
      "method": "GET",
      "path": "/{id}",
      "input_schema": {"type": "object", "properties": {"id": {"type": "integer", "description": "Record id."}}, "required": ["id"]}
    },
    {
      "name": "submissions.list",
      "description": "List form submissions, newest first. Contains personal data.",
      "class": "full",
      "method": "GET",
      "path": "/submissions",
      "input_schema": {"type": "object", "properties": {"form_id": {"type": "integer", "description": "Only this form."}, "status": {"type": "string", "description": "Submission status."}, "search": {"type": "string", "description": "Substring of the submitted data."}, "date_from": {"type": "string", "description": "YYYY-MM-DD."}, "date_to": {"type": "string", "description": "YYYY-MM-DD."}, "page": {"type": "integer", "description": "Default 1."}, "per_page": {"type": "integer", "description": "Rows per page."}}}
    },
    {
      "name": "submissions.get",
      "description": "One submission with all submitted values.",
      "class": "full",
      "method": "GET",
      "path": "/submissions/{id}",
      "input_schema": {"type": "object", "properties": {"id": {"type": "integer", "description": "Record id."}}, "required": ["id"]}
    }
  ],
  "admin_ui": {
    "entry": "admin-ui/dist/index.js",
    "capabilities": [
      {
        "key": "manage_forms",
        "label": "Manage Forms",
        "description": "Create and edit form definitions; view, export, and delete submissions."
      }
    ],
    "routes": [
      { "path": "/", "component": "FormsList" },
      { "path": "/new", "component": "FormEditor" },
      { "path": "/edit/:id", "component": "FormEditor" },
      { "path": "/submissions", "component": "SubmissionsList" },
      { "path": "/submissions/:id", "component": "SubmissionDetail" }
    ],
    "menu": {
      "label": "Forms",
      "icon": "FormInput",
      "section": "content",
      "position": "4",
      "required_capability": "manage_forms",
      "children": [
        { "label": "All forms", "route": "/admin/ext/forms" },
        { "label": "Submissions", "route": "/admin/ext/forms/submissions" }
      ]
    },
    "field_types": [
      {
        "type": "form_selector",
        "label": "Form Selector",
        "description": "Select a form from the Forms extension",
        "icon": "ClipboardList",
        "group": "Forms",
        "component": "FormFieldSelector"
      }
    ]
  }
}
