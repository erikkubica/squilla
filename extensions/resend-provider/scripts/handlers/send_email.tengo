http := import("core/http")
json := import("json")

// Event payload is at event.payload
payload := event.payload

// Extract settings
settings := payload.settings

// Several providers can be active at once; the kernel names the selected
// one (site setting email_provider) in settings.provider. Leave `response`
// unset for any other provider so the send counts as "not handled" here.
// An empty name (a kernel that predates provider routing) counts as ours.
provider := settings.provider
if is_undefined(provider) || provider == "" || provider == "resend-provider" {
    api_key := settings.api_key
    from_email := settings.from_email
    from_name := settings.from_name

    // Build from address
    from := from_email
    if is_string(from_name) && from_name != "" {
        from = from_name + " <" + from_email + ">"
    }

    // Build request body (cc, bcc and reply_to only when set: Resend rejects empty values)
    msg := {
        from: from,
        to: payload.to,
        subject: payload.subject,
        html: payload.html
    }
    // Kernel payload lists arrive as immutable arrays.
    has_items := func(v) { return (is_array(v) || is_immutable_array(v)) && len(v) > 0 }
    if has_items(payload.cc) { msg.cc = payload.cc }
    if has_items(payload.bcc) { msg.bcc = payload.bcc }
    if is_string(payload.reply_to) && payload.reply_to != "" { msg.reply_to = payload.reply_to }
    body := string(json.encode(msg))

    // Send via Resend API
    result := http.post("https://api.resend.com/emails", {
        headers: {
            "Authorization": "Bearer " + api_key,
            "Content-Type": "application/json"
        },
        body: body
    })

    if is_error(result) {
        response = "error: " + string(result)
    } else if result["error"] != "" {
        response = "error: " + result["error"]
    } else if result.status_code < 200 || result.status_code >= 300 {
        response = "error: Resend API returned status " + string(result.status_code) + ": " + result.body
    } else {
        response = "ok"
    }
}
