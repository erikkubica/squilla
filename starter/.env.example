# Squilla Site Environment Variables
PORT=8099
APP_ENV=production

# Database Configuration
DB_USER=squilla
DB_PASSWORD=squilla_super_secret_change_me
DB_NAME=squilla

# Security (generate a random 64-character string)
SESSION_SECRET=change-me-to-a-random-64-char-string
MONITOR_BEARER_TOKEN=change-me-to-a-random-token

# Initial Admin Credentials (leave password blank to auto-generate once in logs)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
