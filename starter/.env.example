# Squilla Site Environment Variables
# Copy to .env and replace every value marked REQUIRED. With
# APP_ENV=production the server refuses to start while any required value
# is missing or still a placeholder.
PORT=8099
APP_ENV=production

# Database Configuration
DB_USER=squilla
# REQUIRED — a strong random password (openssl rand -base64 24)
DB_PASSWORD=
DB_NAME=squilla

# REQUIRED — bearer token for /api/v1/stats (openssl rand -hex 32)
MONITOR_BEARER_TOKEN=
# REQUIRED — at-rest encryption key; must base64-decode to exactly 32 bytes
# (openssl rand -base64 32)
SQUILLA_SECRET_KEY=
# REQUIRED — comma-separated public origin(s) of the site/admin, e.g.
# https://example.com. "*" and "null" are rejected in production.
CORS_ORIGINS=

# Public origin used in password-reset emails (falls back to the site_url
# setting). Set it: production never derives links from the Host header.
SQUILLA_PUBLIC_URL=
# true when behind a TLS-terminating reverse proxy (Traefik, Caddy, nginx…)
TRUST_FORWARDED_PROTO=false

# Initial Admin Credentials (leave password blank to auto-generate once in logs)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# DEPRECATED — no longer used (sessions are random server-side tokens).
# Safe to remove; kept so older .env files keep working.
#SESSION_SECRET=
